@model VuaDoCau.Models.Product
@{
    ViewData["Title"] = "Sửa sản phẩm";
}
<h2 class="mb-3">Sửa sản phẩm</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data" class="row g-3" style="max-width:800px">
    <div asp-validation-summary="All" class="text-danger"></div>

    <!-- Hidden ID -->
    <input type="hidden" asp-for="Id" />

    <!-- GIỮ DUY NHẤT 1 hidden ImageUrl -->
    <input type="hidden" asp-for="ImageUrl" />

    <div class="col-md-6">
        <label class="form-label">Tên sản phẩm</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label class="form-label">SKU</label>
        <input asp-for="Sku" class="form-control" />
    </div>

    <div class="col-md-3">
        <label class="form-label">Slug</label>
        <input asp-for="Slug" class="form-control" readonly />
        <small class="text-muted">Slug tự tạo — không cần sửa.</small>
    </div>

    <div class="col-12">
        <label class="form-label">Tóm tắt</label>
        <input asp-for="Summary" class="form-control" />
    </div>

    <div class="col-md-4">
        <label class="form-label">Giá (VNĐ)</label>
        <input asp-for="Price" type="number" class="form-control" />
    </div>

    <div class="col-md-4">
        <label class="form-label">Giá cũ</label>
        <input asp-for="OldPrice" type="number" class="form-control" />
    </div>

    <!-- 🌟 THÊM MỤC SỐ LƯỢNG -->
    <div class="col-md-4">
        <label class="form-label">Số lượng</label>
        <input asp-for="Stock" type="number" class="form-control" min="0" />
        <span asp-validation-for="Stock" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label class="form-label">Danh mục</label>
        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories"></select>
    </div>

    <div class="col-md-8">
        <label class="form-label">URL Ảnh (hiện tại)</label>
        <input asp-for="ImageUrl" class="form-control" />
    </div>

    <div class="col-md-4">
        <label class="form-label">Upload ảnh mới</label>
        <input type="file" name="ImageFile" class="form-control" accept="image/*" />
    </div>

    <div class="col-12">
        <label class="form-label">Ảnh hiện tại</label><br />
        <img src="@Model.ImageUrl" style="max-height:120px;border-radius:8px" class="mb-2" />
    </div>

    <div class="col-12">
        <button class="btn btn-primary">Cập nhật</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
